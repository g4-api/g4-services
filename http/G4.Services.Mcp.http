@baseUrl = http://localhost:9944
@recordingId = REPLACE-WITH-RECORDING-ID

### Initialize an MCP client
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{
    "jsonrpc": "2.0",
    "id": 1,
    "method": "initialize",
    "params": {
        "protocolVersion": "2025-11-25",
        "capabilities": {},
        "clientInfo": { "name": "manual-client", "version": "1.0" }
    }
}

### Acknowledge initialization (HTTP 202)
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "method": "notifications/initialized" }

### Discover the g4.* system, recording, and flow tools
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 2, "method": "tools/list" }

### Start a Chromium recorder; settings accepts the entire REST start body
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{
    "jsonrpc": "2.0",
    "id": 3,
    "method": "tools/call",
    "params": {
        "name": "g4.StartRecording",
        "arguments": {
            "settings": {
                "authentication": { "token": "" },
                "recorders": [
                    {
                        "enabled": true,
                        "baseUrl": "http://localhost:9956",
                        "driverParameters": { "driver": "ChromeDriver" }
                    }
                ]
            }
        }
    }
}

### Get status
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 4, "method": "tools/call", "params": { "name": "g4.GetRecordingStatus", "arguments": { "id": "{{recordingId}}" } } }

### Stop and return automation
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": { "name": "g4.StopRecording", "arguments": { "id": "{{recordingId}}" } } }

### Retrieve the retained automation
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 6, "method": "tools/call", "params": { "name": "g4.GetAutomation", "arguments": { "id": "{{recordingId}}" } } }

### Find catalog tools through the router; catalog tools are not callable by name
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 7, "method": "tools/call", "params": { "name": "g4.FindTools", "arguments": { "intent": { "agentIntent": "click a button", "userIntent": "click the login button" }, "take": 3 } } }

### Register the retained automation as a flow with one parameter
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 8, "method": "tools/call", "params": { "name": "g4.RegisterFlow", "arguments": { "key": "RecordedLogin", "summary": "Replays the recorded login.", "automation": { "stages": [] }, "parameters": [ { "name": "UserName", "default": "admin" } ] } } }

### List the stored flows
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 9, "method": "tools/call", "params": { "name": "g4.GetFlows", "arguments": {} } }

### Run the flow with a parameter value and a reference ID used to stop it
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 10, "method": "tools/call", "params": { "name": "g4.InvokeFlow", "arguments": { "key": "RecordedLogin", "parameters": { "UserName": "root" }, "referenceId": "recorded-login-1" } } }

### Stop the running flow invocation
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 11, "method": "tools/call", "params": { "name": "g4.StopFlowInvocation", "arguments": { "automationId": "recorded-login-1" } } }

### Remove the flow
POST {{baseUrl}}/api/v4/g4/mcp
Content-Type: application/json
Accept: application/json, text/event-stream
MCP-Protocol-Version: 2025-11-25

{ "jsonrpc": "2.0", "id": 12, "method": "tools/call", "params": { "name": "g4.RemoveFlow", "arguments": { "key": "RecordedLogin" } } }

### Refresh the cached tool catalog (HTTP 204)
GET {{baseUrl}}/api/v4/g4/mcp/sync
