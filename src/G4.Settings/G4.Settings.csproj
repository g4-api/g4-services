<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Assembly -->
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<FileVersion>10.0.0.0</FileVersion>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>

		<!-- Package -->
		<PackageId>G4.Settings</PackageId>
		<Title>G4.Settings</Title>
		<PackageProjectUrl>https://github.com/g4-api</PackageProjectUrl>
		<Authors>G4™ API Community</Authors>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>Apache-2.0+</PackageLicenseExpression>
		<Description>
			The AppSettings library provides a convenient and centralized way to manage application settings, including configuration, JSON serialization options, and LiteDB connections.
			This library simplifies the initialization of these settings, making it easy to integrate with your .NET applications.
		</Description>
		<PackageTags>WebDriver;Automation;Testing;RPA;G4</PackageTags>
		<Copyright>Copyright 2023 (c) Roei Sabag &amp; HRC Corporation. All rights reserved.</Copyright>

		<!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/syslib-diagnostics/syslib1040-1049 -->
		<NoWarn>$(NoWarn);SYSLIB1045;IDE0130</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="G4.Converters" Version="2026.11.9.99" />
		<PackageReference Include="LiteDB" Version="5.0.17" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Ini" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Xml" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Primitives" Version="10.0.14" />
	</ItemGroup>

</Project>
