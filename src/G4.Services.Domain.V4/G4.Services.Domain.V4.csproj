<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Assembly -->
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<FileVersion>10.0.0.0</FileVersion>
		<IsPackable>false</IsPackable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>

		<!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/syslib-diagnostics/syslib1040-1049 -->
		<NoWarn>$(NoWarn);SYSLIB1045;IDE0130;CA1873</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="G4.Api" Version="2026.11.10.68" />
		<PackageReference Include="G4.Cache" Version="2026.11.9.99" />
		<PackageReference Include="G4.Plugins" Version="2026.11.9.99" />
		<PackageReference Include="G4.Plugins.Common" Version="2026.11.10.165" />
		<PackageReference Include="G4.Plugins.Google" Version="2026.11.10.165" />
		<PackageReference Include="G4.Plugins.Ui" Version="2026.11.10.165" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />

		<!-- Pin: G4.Plugins.SqlServer -> Microsoft.Data.SqlClient 7.1.1 floors this at vulnerable 9.0.18 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); remove once G4.Api ships the fixed plugin -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="G4.Services.UnitTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\G4.Settings\G4.Settings.csproj" />
	</ItemGroup>

</Project>
