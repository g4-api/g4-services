<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Assembly -->
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyVersion>10.0.0.0</AssemblyVersion>
		<FileVersion>10.0.0.0</FileVersion>
		<IsPackable>false</IsPackable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>

		<!-- https://learn.microsoft.com/en-us/dotnet/fundamentals/syslib-diagnostics/syslib1040-1049 -->
		<NoWarn>$(NoWarn);SYSLIB1045;IDE0130;CA1873</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="G4.Api" Version="2026.10.31.63" />
		<PackageReference Include="G4.Plugins" Version="2026.10.30.89" />
		<PackageReference Include="G4.Plugins.Common" Version="2026.10.31.153" />
		<PackageReference Include="G4.Plugins.Ui" Version="2026.10.31.153" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />
		<PackageReference Include="Swashbuckle.AspNetCore.Annotations" Version="10.3.1" />
		<PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**\*.*" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="G4.Services.UnitTests" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\G4.Settings\G4.Settings.csproj" />
	</ItemGroup>

</Project>
